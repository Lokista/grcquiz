{
  "name": "grcquiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Edukacyjna gra webowa: IT Audyt / GRC oraz Bezpieczeństwo IT w sektorze publicznym (KSC/NIS2, EDR, incydenty)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "build:pages": "cross-env GITHUB_PAGES=true vite build",
    "zip": "node scripts/zip-dist.mjs",
    "package": "npm run build:pages && npm run zip",
    "validate:secops": "node scripts/validate-secops.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lokista/grcquiz.git"
  },
  "homepage": "https://lokista.github.io/grcquiz/"
}
